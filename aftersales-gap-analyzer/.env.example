# Copy to .env (never commit .env).

# --- which backends to use --------------------------------------------------
AFSGAP_LLM=claude                  # claude (hosted API) | ollama (fully local)
# One backend or a fallback chain, tried in order. `seeds` needs no search
# engine at all - it uses the URLs you list in data/seed_sources.yaml.
AFSGAP_SEARCH=duckduckgo,mojeek,seeds   # duckduckgo | mojeek | searxng | seeds | none
# AFSGAP_SEARXNG_URL=http://localhost:8080

# --- hosted backend ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- local backend (Ollama) -------------------------------------------------
AFSGAP_OLLAMA_HOST=http://localhost:11434
AFSGAP_OLLAMA_MODEL=qwen2.5:7b     # realistic on a laptop; 14b if you have the hardware
AFSGAP_OLLAMA_NUM_CTX=8192         # bigger context = slower; raise only if truncated
AFSGAP_OLLAMA_NUM_PREDICT=6144     # output cap per stage
AFSGAP_OLLAMA_CHUNK_TIMEOUT=180    # give up only if NO token arrives for this long
AFSGAP_OLLAMA_TIMEOUT=3600         # overall guard rail for one stage (0 = none)
AFSGAP_OLLAMA_KEEP_ALIVE=30m       # keep the model resident between stages
AFSGAP_LOCAL_COMPACT=true          # ask for fewer, shorter items - the main speed lever
AFSGAP_LOCAL_MAX_ITEMS=6
AFSGAP_LOCAL_MAX_PAGES=4           # pages fed to the model per research stage
AFSGAP_LOCAL_PAGE_CHARS=2500
AFSGAP_VERIFY_QUOTES=true          # drop quotes not literally present in the cited page
AFSGAP_OPENALEX_ENABLED=true       # set false for a run with minimal outbound traffic

# --- Confluence (where the AS-IS process is read from) -----------------------
# Cloud:       https://yourcompany.atlassian.net/wiki   + email + API token
# Data Center: https://confluence.yourcompany.com       + personal access token
AFSGAP_CONFLUENCE_BASE_URL=
AFSGAP_CONFLUENCE_EMAIL=you@yourcompany.com
AFSGAP_CONFLUENCE_API_TOKEN=
AFSGAP_CONFLUENCE_AUTH=auto             # auto | basic (Cloud) | bearer (Data Center PAT)
AFSGAP_CONFLUENCE_SPACES=AFTS,LOG       # optional: restrict the search to these spaces
AFSGAP_CONFLUENCE_MIN_MATCH=0.45        # below this, the process counts as new
AFSGAP_CONFLUENCE_SEARCH_LIMIT=10

# --- model ------------------------------------------------------------------
AFSGAP_MODEL=claude-opus-5
AFSGAP_EFFORT=high                 # low | medium | high | xhigh | max

# --- research budget --------------------------------------------------------
AFSGAP_SAP_MAX_SEARCHES=12
AFSGAP_INDUSTRY_MAX_SEARCHES=14
AFSGAP_OPENALEX_MAILTO=you@example.com    # puts you in OpenAlex's polite pool
AFSGAP_OPENALEX_FROM_YEAR=2015

# --- corporate network (TLS interception) -----------------------------------
# Symptom: CERTIFICATE_VERIFY_FAILED / "self-signed certificate in certificate
# chain" on every outbound call. Run `python -m afsgap doctor` for a diagnosis.
AFSGAP_USE_SYSTEM_TRUST=true       # use the OS certificate store (needs truststore)
# AFSGAP_CA_BUNDLE=C:\path\to\corp-ca-bundle.pem   # from: python -m afsgap export-ca-bundle
# AFSGAP_INSECURE_TLS=false        # last resort; disables verification entirely

# --- guards -----------------------------------------------------------------
AFSGAP_REQUIRE_LITERAL_TCODE_EVIDENCE=true   # never relax this in a real run
AFSGAP_FAIL_ON_VALIDATION_ERROR=true

# --- paths ------------------------------------------------------------------
# AFSGAP_CACHE_DIR=.cache
# AFSGAP_OUTPUT_DIR=output
